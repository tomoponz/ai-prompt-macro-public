{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.4.4",
  "version_name": "0.4.4",
  "description": "__MSG_extensionDescription__",
  "default_locale": "ja",
  "icons": {
    "16": "src/icons/apm-16.png",
    "32": "src/icons/apm-32.png",
    "48": "src/icons/apm-48.png",
    "128": "src/icons/apm-128.png"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "scripting",
    "power"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "src/icons/apm-16.png",
      "32": "src/icons/apm-32.png",
      "48": "src/icons/apm-48.png",
      "128": "src/icons/apm-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/content-core.js",
        "src/content-runner.js",
        "src/content-controller.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ]
}
